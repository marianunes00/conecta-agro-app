NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Chave de serviço (service_role secret) do Supabase (Project Settings -> API -> service_role)
# Necessária para a rota /api/ingest gravar medições enviadas por dispositivos IoT (ESP32/Postman)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# (Opcional) Chave de segurança para proteger a rota /api/ingest. Se vazia, aceita qualquer chamada válida.
INGEST_API_KEY=
